# Copy this file to .env and adjust values for your environment.

# For local SQLite (quick start / development):
DATABASE_URL=sqlite:///./pm_api.db

# For PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql://pm_user:pm_password@localhost:5432/pm_api

SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=uploads
EMAIL_NOTIFICATIONS_ENABLED=false
